# Las variables NO son las mismas para todos los servicios, y eso es la
# arquitectura: recepción lleva WAHA_* y no lleva OPENAI; los workers al revés.
# Un worker con WAHA_API_KEY significa que alguien le hizo mandar un mensaje
# directo, y ahí se rompe la única frontera de proceso del sistema.

# ── Claude ────────────────────────────────────────────────────────────────────
# Workers (vendedores, clientes, supervisores) y yahuar.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=
MODELO_ORQUESTADOR=

# ── Embeddings del RAG de procesos ────────────────────────────────────────────
# ÚNICO uso de OpenAI en todo el sistema: el razonamiento sigue en Claude.
# Cambiar EMBEDDING_MODEL obliga a re-embeber todas las filas de conocimiento_*.
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small

# ── Datos ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/catusita_db
REDIS_URL=redis://localhost:6379

# API de Catusita (workers). SAP_* hoy lo lee solo `clientes`.
CATUSITA_API_URL=
SAP_BASE_URL=
SAP_API_KEY=

# ── WAHA — SOLO recepción y yahuar ────────────────────────────────────────────
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=
WAHA_WEBHOOK_TOKEN=
# Aislamiento por canal: se encienden cuando haya un número por multiagente.
WAHA_SESSION_VENDEDORES=
WAHA_SESSION_CLIENTES=
WAHA_SESSION_SUPERVISORES=

# ── Panel (solo lectura) ──────────────────────────────────────────────────────
# Sin PANEL_PASSWORD el panel queda abierto con los chats de los asesores adentro.
PANEL_PASSWORD=
PANEL_SECRET=
PANEL_CORS=*
PANEL_TOKEN_TTL=

# ── Yahuar (consulta de placas) ───────────────────────────────────────────────
YAHUAR_NUMBER=
YAHUAR_LID=
YAHUAR_MODELO_VISION=
YAHUAR_DEBOUNCE=
YAHUAR_ESPERA_MAX=

# ── Límites del grafo (opcionales, tienen default) ────────────────────────────
LANGGRAPH_RECURSION_LIMIT=20
LIMITE_PASOS_AREA=
